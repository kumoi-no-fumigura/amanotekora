 "poems": [
  {
   "seq": "1",
   "text": "白妙の雪はかすみもみよし野のかさねてけふや立はしむらん",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "こち風に氷うすくていけかをものつらゝもへゆるをしの鴨鳥",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "かくせともをそきはるへにひとりいてなかむる宮の鶯の聲",
   "kana": "",
   "speaker": "海人手子良集",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "にほふかのめも春風にさきたゝはちりやそむらん紅の梅",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "とふ人もみえぬよもきのもとなれや今はすみれの盛なる哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "いとまなみ淀のさしつる程もなく春の遊ひのよるのよるとか",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "陸奥のまかきのわたりいそなめてわかめかりにそ蜑も行かふ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "久かたのみとりの空の雲間より聲もほのかにかへるかりかね",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "わきも子かまゆににたれは靑柳のなひくにつけてます淚哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "春のすゑ夏のもとにはかゝれともまつにみたれぬ岸の藤なみ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "やをとめもけふやひとへに夏衣神のみそきそいそきたつらむ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "見渡は今はもえきもみとりにてなくみをとりの聲のみそする",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "うの花のさかりになれは時鳥夜ふかきねにそ有明の月",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あやめ草軒の限りはひまもなみけふはよとのやあらは成らん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "數ならぬしつかたまきもをのかしる今は早苗のいそかしき哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "みたれすてこの下やみにをくら山ふもとに鹿をともすあき人",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あせもよにみたるゝ夏も涼しきは君にあふきのかせはやみ也",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "高瀨さす鵜飼も今はをりたちて水なつかしきかものうはなみ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "しけりあひて亂るゝ荻の上葉すら靡くは夏もみなつきぬらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "露結ふもとあらの荻の末たをになりゆく秋もちかつきに鳬",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "鵠のゆきあひの橋のつきなれは猶わたすへき日社とをけれ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "聲よはみ亂るゝ虫をこからしの露ふきむすふ秋の夜な〓〓",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "ひこほしのなかめにけふは天の川さしてやわたる鵠の橋",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "白露と草葉にをきて秋のよを聲もすからにめくる松むし",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "山吹の色にかひあるをみなへしさのみやゐての名にはある覽",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "霞たち立かへりにし鴈金もけふそ雲井にきりはれてなく",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "たかさこに立わたりたる霧間より紅葉の色のふかき奥山",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "八重菊のうつるひわたる庭の面にかねても結ふ夜はの白露",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "ほの〓〓と天のと渡りあけたれはこきませなりやよもの玉垣",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "ぬきかふる衣のつさにたつものはけふ珍らしき火おけんけり",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "陸奥のうたの濵へにこのはかたなからむ冬のかせうからまし",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "吾妹子か玉ハうてなに獨ゐていとゝわさなにやまなかたらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "あしたつの遊ふすさきも冬くれはけさしも冬の心ちみえけり",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "しも月のひよりもうちの網代木にいまも氷のいほにさりける",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "をみかよふこゝのかさねにひかりさし豐の明に見ゆる妹哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "をし鳥の衾のなかもすゝしやとよな〓〓しもの夕重ねつゝ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "雲たかきよものたかれもかたちなるみなしら山にみゆる比哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "都へとゆきかふ人の道もなみとしのせめてもいそかしきかな",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "百敷の大宮人もむれゐつゝこそとやけふをあすはかたらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いかて猶みてのかさまもえてしがな我する戀の數のしるしに",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "あふ坂のうたかた人は陸奥のさらになこそをなつくるかもし",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "歎きつゝかたしく袖にくらふれは〓見かせきの浪はものかは",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "よと共になへてけしきを陸奥のさは此身よといはせてしかな",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "すはの海の神のみまるを詠めつゝけふひねもすにをり暮す哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "きみかふる淚は袖にひたちなるいろつくそこの峯はなるらし",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "君しいなはいな〓〓こそは信濃なる淺間か山と成やはてなん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "あつまちのはまなの橋のはやくより深き心はくみてしるらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "かひもなきいくたのうらをあさりつゝ淚なからにかへる釣舟",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "たそかれに涙の玉を詠めつゝねふしてよはにあかすともし火",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "こゆるきにさしいてゝみれは天の原波間にこゆる舟のわれ哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "いはゝしをつくりさしけん葛城の神にけなくもあさほらけ哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "ひまもなく涙に袖をぬらしつゝこまに任せてかへるよな〓〓",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "通へとも常にまとふを武藏なるさゝのやまへのしるへせよ君",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "わりなきをしなむふしなむみまさかやくめのさら山今更に君",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "あひてあはぬ歎き駿河のふしの浦に焦れて歸るあまの舟かも",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "わくらはにあふかはあふか陸奥のしのふのちすり數ふ計りを",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "しのひれに又忍ひねの重なりてひるまなく〓〓袖くちぬへし",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "逢坂の道にかきほは越なからまたゆるされぬしたひものせき",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "ひなたかのよもの別もかくやたつ烟はみよにすきにたる哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "わかれちをけふそかきりと陸奥のいはて忍ふにぬるゝ袖哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "いまはとてわかるゝ人をみくまのゝ浦の濵ゆふ重ねてそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "別路となつくるたひはたまほこのみち見ぬ人も猶惑ふらし",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "別路に行もとまるも二こゝろ袖にうきてもなけく比かな",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "わかるゝを心つくしにくたるともいきの松原色かはらめや",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "別路は千草のとのをさしなからいなくら山のこまとこそみれ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "結ふての雫ににこる月影の身としりぬれはちよもいな!",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "春たては子日の松をひきつれていつら祈りし千世のしるしは",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "ともしひの影にならへし世中をいつれ久しとかすめてしかな",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "ちよをまつ松の綠とみえしよははやつきくさのうつし成けり",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "朝かほに露の命をくらふれは花のにほひはひさしかりけり",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "庭の面にうきて漂ふうたかたのまたきえぬまにかはる世の中",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "澤の面に年ふるたつのちよをへて後ははねうつ程もなしとや",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "色深き峯の紅葉も山川のそこにくちはのみくつとそなる",
   "kana": "",
   "speaker": "海人手子良集",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "しつもなしみとりとみえすすかはねし何れも白き渚なりけり",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "さゝれ石におひむよ松にすを作るたつの日なきも君はすみ南",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "山彥をしるへになしてみとりにもいつくかがめの內に通はん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "斧のえをてならしそめぬ君なれは何をかくたす何はくたさん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "三千年になるてふもゝのもゝかへり君かためにとうへし山人",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "ころもしてなつる巖のつくるまて君か齢をしらさらめやは",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "蘆田鶴の千世の齡をさしなから君にゆつるとなつくるかゝも",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "限なき齡をのふるうら島のこのたまくしけのとけしや君",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "君か世は猶おほはらのをしほ山なつのゝすゑもたのもしき哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "昔よりかすかのふちの榮ゆれは今のつかひもかさしなりけり",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "思はんとしのひ〓〓にちかひしを今はたゝすの神そゆゝしき",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "たかかたの浦〓〓とにかつきつゝ蜑は苦屋にいくかへぬらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "風ふけはひゝきのなたのをと高み浪の末わくあまのつり舟",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "いとふこと君を思ふも思ふこなをしかすかのわたりにてこそ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "ませちかくこふる花しも匂ふかなこやこからしの秋の初かせ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "鶯の木つたひちらす櫻はなこや春の日のをそきなりけり",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "身をてらす螢きえなは夏の夜の水際くらしと火をともすらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "池水ののとけき底にかけなみそさるは鏡にみゆるなきはを",
   "kana": "",
   "speaker": "朝光卿集",
   "page": 96,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "わかるともきみを汀にのほるにはいきの松原はたみさらめや",
   "kana": "",
   "speaker": "",
   "page": 96,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "別るとも身のうちふねそうかりける手向の神もみえぬ浪かは",
   "kana": "",
   "speaker": "",
   "page": 96,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "秋の夜の月影うかふ水のおもやあまの川ともみえわたろらん",
   "kana": "",
   "speaker": "",
   "page": 96,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
  "work_id": "gunsho09-amanotekora",
